# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/.playwright-mcp/
/output/playwright/
/.worktrees/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
/.claude/
/outputs/
docs/claude-design/project/.thumbnail
docs/claude-design/project/support.js
docs/claude-design/project/assets/
*.pem

# local research / working docs (repo에 커밋하지 않는 로컬 작업 문서)
docs/online-popup/
docs/research/

# 로컬 프로토타입 (각자 node_modules·dist·test-results를 갖는 별도 프로젝트)
/prototypes/

# Claude Design handoff (로컬 참조용 시각 진실원 — 68MB, git에 올리지 않음)
design/handoff/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local state
/supabase/.branches/
/supabase/.temp/

# box2d-wasm 정적 자산 (postinstall이 node_modules에서 복사)
/public/box2d/
