# Supabase (scaffolding) — copy to .env.local and fill in from
# Supabase dashboard → Project Settings → API.
# Until these are set, local public catalog routes use mock data and
# the auth middleware is a no-op.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects can still use the anon key as a fallback until Supabase
# removes legacy keys. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only override for catalog/search source.
# Vercel Preview defaults to mock even when Supabase env vars exist.
# Allowed values: mock, supabase.
ICONS_CATALOG_SOURCE=

# Server-only secret for domain-separated HMAC signatures on signup resend,
# Auth next, and password reset request state cookies.
# Generate a long random value and keep it out of client-exposed env vars.
AUTH_SIGNUP_RESEND_SECRET=

# General server-only canonical public origin. Production must use this exact
# value so Toss successUrl/failUrl and Korpay returnUrl callbacks are created
# on the canonical domain.
SITE_URL=https://iconsip.com

# Server-only bearer secret for the scheduled admin artwork cleanup route.
# Production requires 16-128 URL-safe characters; do not use NEXT_PUBLIC_.
CRON_SECRET=

# #191 Send Email Hook dark path (server only). Keep unset in Preview/CI and
# keep the Supabase Hook disabled until Production canary prerequisites pass.
SUPABASE_SEND_EMAIL_HOOK_SECRET=
EMAIL_DISPATCH_HMAC_SECRET=
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# Optional Resend-compatible endpoint override; normally leave empty.
RESEND_API_ENDPOINT=

# Separate server-only bearer secret for explicit payment reconciliation.
# Production only; Preview/CI must leave it unset and use Fake gateways.
PAYMENT_RECONCILIATION_SECRET=

# Toss is the default PG for new goods/ticket payments (ADR-0013). Production
# only; the client and secret key must share one mode (test/live). Public
# rollout gates stay false until the review track opens them.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_ORDER_CHECKOUT_ENABLED=false
TOSS_TICKET_CHECKOUT_ENABLED=false
TOSS_ORDER_CANARY_USER_ID=
TOSS_TICKET_CANARY_USER_ID=

# Korpay is kept for sale-restricted goods only and stays Production-only. Keep
# credentials/canary ids unset in Preview/CI. Public rollout gates stay false
# until the 19+ track reopens them.
KORPAY_MID=
KORPAY_KEY=
KORPAY_ORDER_CHECKOUT_ENABLED=false
KORPAY_TICKET_CHECKOUT_ENABLED=false
KORPAY_ORDER_CANARY_USER_ID=
KORPAY_TICKET_CANARY_USER_ID=

# 무통장 계좌 표시값은 /admin/settings/store에서 설정한다 (#426).
# BANK_TRANSFER_* env는 더 이상 읽지 않는다. docs/runbooks/admin-store-settings.md 참고.
