{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2018",
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "test/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next/dev/types",
    "prototypes/**",
    ".worktrees/**",
    ".claude/**"
  ]
}
